node_modules/
/vendor/
.env
.env.local
.env.*.local
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
# Zona de trabajo: arneses de render, diagnosticos de una sesion y scripts
# que se ejecutan una vez (pruebas de memoria, generadores de SVG, carga de
# datos de prueba). No son parte de la aplicacion y sus rutas cambian con la
# maquina: por eso viven fuera del versionado y no en scripts/, que queda
# solo para los verificadores.
scratch/

# Artefactos que generan los scripts de prueba.
storage/*.pdf
storage/**/*.pdf

# Copias de seguridad que se crean al desplegar.
.DS_Store
dist/
build/
coverage/
.vscode/
.idea/

# Metadatos de zona alternativa de NTFS que llegan al repo desde Windows
*:Zone.Identifier

# Fotografias de empleados y estudiantes que sube la aplicacion.
# Son datos personales: nunca deben entrar al repositorio.
public/uploads/

# Respaldos de la base de datos. Llevan la base completa: documentos de identidad,
# correos y hashes de contrasena de personas reales. Se guardan en
# database/backups/ para consulta local, pero no se versionan.
database/backups/*.sql
database/backups/*.dump
