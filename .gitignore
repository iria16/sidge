# Metadatos de zona alternativa de NTFS que llegan al repo desde Windows
*:Zone.Identifier

# Fotografias de empleados y estudiantes que sube la aplicacion.
# Son datos personales: nunca deben entrar al repositorio.
public/uploads/*
!public/uploads/.gitkeep
!public/uploads/.htaccess
!public/uploads/institucion/
public/uploads/institucion/*
!public/uploads/institucion/.gitkeep
!public/uploads/institucion/.htaccess
public/uploads/empleados/*
!public/uploads/empleados/.gitkeep
public/uploads/estudiantes/*
!public/uploads/estudiantes/.gitkeep

# Respaldos de base de datos: nunca al repositorio
database/backups/*

# Almacenamiento privado (firmas y sellos institucionales, respaldos)
storage/*
!storage/.gitkeep
!storage/.htaccess
!storage/rate_limit/
storage/rate_limit/*
!storage/rate_limit/.gitkeep
!storage/institucion/
storage/institucion/*
!storage/institucion/.gitkeep
!storage/institucion/.gitignore
!storage/institucion/firma/
storage/institucion/firma/*
!storage/institucion/firma/.gitkeep
!storage/institucion/sello/
storage/institucion/sello/*
!storage/institucion/sello/.gitkeep

# Residuos temporales y respaldos manuales
*.bak
*.bkp
*.tmp
*.swp
*~
*.orig

# Volcados de sesiones de trabajo
chunk*.txt
step*.txt
extracted_*.txt

# Redirecciones accidentales de terminal en raiz
/curl
/echo
/pdo
/test_db.php

# Servidor y pruebas locales
/storage/pruebas/
/storage/boletas/*.pdf
/storage/boletas/*.png
/storage/constancias_muestra/
/storage/constancias_prueba/
/storage/pruebas_encabezado/
