# ─────────────────────────────────────────────────────────────────────────────
# SIGDE — Credenciales de la base de datos
#
# Copia este archivo a .env y rellena los valores:
#
#     cp .env.example .env
#
# El archivo .env está en .gitignore: NO debe subirse al repositorio nunca.
# Este .env.example sí se versiona, y por eso no lleva valores reales.
# ─────────────────────────────────────────────────────────────────────────────

# Servidor de base de datos.
# En local suele ser 127.0.0.1; en hosting externo va el host que te den.
DB_HOST=127.0.0.1

# Nombre de la base de datos. El esquema está en database/schema_actual.sql.
DB_NAME=sidge

# Usuario de MySQL.
# IMPORTANTE: usa un usuario propio de la aplicación, no root.
# root puede borrar el servidor entero; este usuario solo puede leer y
# escribir en DB_NAME. Ver la sección "Base de datos" del README.
DB_USER=

# Contraseña de ese usuario.
# Se deja vacía a propósito: no se publica un ejemplo con una clave real
# porque alguien acaba copiándolo tal cual.
# En .env sí va la clave que tú elijas al crear el usuario.
DB_PASS=